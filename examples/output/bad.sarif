          "ruleIndex": 15,
          "level": "warning",
          "message": {
            "text": "The receipt_date of row 4 (initial packing), 2101-03-05, is before the harvest_date, 2101-03-07. Fix: Check each date against the business record; food cannot be received before it is harvested or packed before it is received."
          },
          "locations": [
