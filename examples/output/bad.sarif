            "subject": null
          }
        },
        {
          "ruleId": "column-duplicate",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "The column \"Event Date\" has the same name as column 11 once case and separators are ignored; only the first is read. Fix: Keep one column of each name."
          },
          "locations": [
