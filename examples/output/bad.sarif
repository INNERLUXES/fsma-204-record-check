          "ruleIndex": 10,
          "level": "warning",
          "message": {
            "text": "Row 5 (shipping) names the place it ships from as the source of the lot code LOT-Z9, but no row of the file assigns that lot code, and 21 CFR 1.1320(b) says not to establish a new lot code when shipping. Fix: Ship the food under the lot code it already has, and add the row of the event that assigned it; if the lot code came from elsewhere, name that place as the lot code source."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/records.csv",
